# ==============================================================================
# 🔑 SKILLSTOIAS - TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com as suas credenciais reais.
# NUNCA comite o arquivo .env no Git!

# ------------------------------------------------------------------------------
# 🧠 SERVIDORES MCP & INTELIGÊNCIA ARTIFICIAL
# ------------------------------------------------------------------------------
# Chave de API para o servidor Context7 (Documentação oficial atualizada)
CONTEXT7_API_KEY=ctx7sk-seu-token-aqui

# Token de autenticação Bearer para o servidor OpenScreen MCP (Gravação de tela)
OPENSCREEN_MCP_TOKEN=seu-token-openscreen-aqui

# Token para o banco de dados serverless Neon Postgres MCP
NEON_API_KEY=napi_seu-token-neon-aqui

# Chave do Notion MCP Server (Integração com workspaces e bases de dados)
NOTION_API_KEY=secret_seu-token-notion-aqui

# Chave do Apollo.io MCP Server (Prospecção de leads B2B)
APOLLO_API_KEY=seu-token-apollo-aqui

# ------------------------------------------------------------------------------
# 📱 REDES SOCIAIS & MÍDIA
# ------------------------------------------------------------------------------
# Token de acesso ao Buffer MCP (Agendamento no LinkedIn e Instagram)
BUFFER_ACCESS_TOKEN=seu-token-buffer-aqui

# ------------------------------------------------------------------------------
# ☁️ DEPLOY & INFRAESTRUTURA
# ------------------------------------------------------------------------------
# Token de automação para deploy contínuo na Vercel
VERCEL_TOKEN=seu-token-vercel-aqui
