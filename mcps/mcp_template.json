{
  "mcpServers": {
    "prospector-crm": {
      "url": "https://api-prospector-delta.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer SUA_CHAVE_PROSPECTOR_CRM_AQUI"
      }
    },
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "mcp-server-neon": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.neon.tech/sse"
      ]
    },
    "notion-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer SUA_NOTION_INTEGRATION_KEY\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.0.0",
        "mcp"
      ]
    },
    "buffer": {
      "serverUrl": "https://mcp.buffer.com/mcp"
    },
    "shots-studio": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "c:\\Users\\Public\\Downloads\\shots-studio\\mcp-server\\index.ts"
      ]
    },
    "apollo": {
      "serverUrl": "https://mcp.apollo.io/mcp"
    },
    "ai-memory": {
      "serverUrl": "http://127.0.0.1:49374/mcp",
      "timeout": 5000
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer SUA_CHAVE_GITHUB_PAT_AQUI"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "brightdata": {
      "serverUrl": "https://mcp.brightdata.com/mcp?token=SEU_TOKEN_BRIGHTDATA_AQUI"
    },
    "magicuidesign-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "desktop-commander": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "Prisma-Remote": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.prisma.io/mcp"
      ]
    },
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@cablate/mcp-google-map",
        "--stdio"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "YOUR_API_KEY"
      }
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.vercel.com"
      ]
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@netlify/mcp"
      ]
    },
    "mongodb-atlas-mcp-remote": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-atlas-mcp-remote@latest"
      ],
      "env": {
        "MDB_MCP_API_CLIENT_ID": "SEU_CLIENT_ID_ATLAS",
        "MDB_MCP_API_CLIENT_SECRET": "SEU_CLIENT_SECRET_ATLAS"
      }
    },
    "browserstack": {
      "serverUrl": "https://mcp.browserstack.com/mcp"
    },
    "youtube-music-server": {
      "command": "node",
      "args": [
        "c:\\caminho\\para\\youtube-music-server\\build\\index.js"
      ]
    },
    "spotify": {
      "command": "uv",
      "args": [
        "--directory",
        "c:\\caminho\\para\\spotify-mcp",
        "run",
        "spotify-mcp"
      ],
      "env": {
        "SPOTIFY_CLIENT_ID": "SEU_CLIENT_ID_SPOTIFY",
        "SPOTIFY_CLIENT_SECRET": "SEU_CLIENT_SECRET_SPOTIFY",
        "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8080/callback"
      }
    },
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "@next-ai-drawio/mcp-server@latest"
      ]
    },
    "mcp-server-linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}